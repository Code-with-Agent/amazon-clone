<mvc:View
    controllerName="marketplace.admin.controller.Promotions"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="promotionsListPage" title="Marketing Campaigns &amp; Promotions" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <Table id="promotionsTable"
                   items="{/Promotions}"
                   growing="true"
                   growingThreshold="20"
                   itemPress=".onPromotionPress">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Promotional Campaigns" level="H3" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://refresh" type="Transparent" press=".onRefresh" tooltip="Refresh" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="18%"><Text text="Campaign Code" /></Column>
                    <Column width="22%"><Text text="Campaign Name" /></Column>
                    <Column width="16%"><Text text="Discount Type" /></Column>
                    <Column width="14%" hAlign="End"><Text text="Discount Value" /></Column>
                    <Column width="14%" hAlign="Center"><Text text="Redeemed" /></Column>
                    <Column width="16%" hAlign="Center"><Text text="Active" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onPromotionPress">
                        <cells>
                            <ObjectIdentifier title="{code}" />
                            <VBox>
                                <Text text="{name}" />
                                <Text text="{description}" class="auraKpiSubtext" />
                            </VBox>
                            <Text text="{discountType}" />
                            <Text text="{discountValue}" />
                            <Text text="{usageCount} / {usageLimit}" />
                            <Switch state="{isActive}" enabled="false" customTextOn="Active" customTextOff="Off" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
