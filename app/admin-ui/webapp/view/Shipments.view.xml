<mvc:View
    controllerName="marketplace.admin.controller.Shipments"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="shipmentsListPage" title="Fulfillment Logistics &amp; Consignments" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <Table id="shipmentsTable"
                   items="{path: '/Shipments', parameters: {$expand: 'order,warehouse'}}"
                   growing="true"
                   growingThreshold="20"
                   itemPress=".onShipmentPress">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Shipment Consignments" level="H3" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://refresh" type="Transparent" press=".onRefresh" tooltip="Refresh" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="22%"><Text text="Tracking Number" /></Column>
                    <Column width="16%"><Text text="Carrier" /></Column>
                    <Column width="18%"><Text text="Order Number" /></Column>
                    <Column width="16%"><Text text="Warehouse" /></Column>
                    <Column width="14%" hAlign="Center"><Text text="Status" /></Column>
                    <Column width="14%"><Text text="Shipped At" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onShipmentPress">
                        <cells>
                            <ObjectIdentifier title="{trackingNumber}" />
                            <Text text="{carrier}" />
                            <Text text="{order/orderNumber}" />
                            <Text text="{warehouse/name}" />
                            <ObjectStatus text="{status}" state="{path: 'statusCriticality', formatter: '.formatCriticalityState'}" inverted="true" />
                            <Text text="{path: 'shippedAt', formatter: '.formatDate'}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
