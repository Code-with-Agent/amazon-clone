<mvc:View
    controllerName="marketplace.admin.controller.Sellers"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="sellersListPage" title="Seller Management &amp; Merchant Governance" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <Table id="sellersTable"
                   items="{/Sellers}"
                   growing="true"
                   growingThreshold="20"
                   itemPress=".onSellerPress">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Marketplace Merchants" level="H3" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://refresh" type="Transparent" press=".onRefresh" tooltip="Refresh" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="22%"><Text text="Store Name" /></Column>
                    <Column width="22%"><Text text="Legal Entity" /></Column>
                    <Column width="20%"><Text text="Contact Email" /></Column>
                    <Column width="12%" hAlign="Center"><Text text="Rating" /></Column>
                    <Column width="12%" hAlign="End"><Text text="Commission %" /></Column>
                    <Column width="12%" hAlign="Center"><Text text="Status" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onSellerPress">
                        <cells>
                            <ObjectIdentifier title="{storeName}" text="ID: {externalSellerId}" />
                            <Text text="{legalEntity}" />
                            <Text text="{contactEmail}" />
                            <RatingIndicator value="{rating}" maxValue="5" editable="false" iconSize="0.8rem" />
                            <Text text="{commissionRate}%" />
                            <ObjectStatus text="{status}" state="{path: 'statusCriticality', formatter: '.formatCriticalityState'}" inverted="true" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
