<mvc:View
    controllerName="marketplace.shop.controller.Reviews"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="reviewsPage" showHeader="false" enableScrolling="true" class="auraPage">
        <content>
            <VBox class="sapUiMediumMarginTop sapUiMediumMarginBegin sapUiMediumMarginEnd">
                <Breadcrumbs currentLocationText="{i18n>pdpCustomerReviews}">
                    <Link text="Home" press=".onNavHome" />
                    <Link text="Back to Product" press=".onBackToProduct" />
                </Breadcrumbs>
                <Title text="{i18n>pdpCustomerReviews}" level="H2" class="sapUiSmallMarginTop" />
            </VBox>

            <!-- Reviews Overview & List -->
            <VBox class="sapUiMediumMargin" renderType="Bare">
                <!-- Header with Action Button -->
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom" wrap="Wrap">
                    <HBox alignItems="Center">
                        <RatingIndicator value="4.8" maxValue="5" visualMode="Half" enabled="false" iconSize="1.5rem" />
                        <Text text="4.8 out of 5 stars (Customer verified)" class="sapUiSmallMarginBegin auraActionMaintext" />
                    </HBox>
                    <Button text="{i18n>pdpWriteReview}" type="Emphasized" icon="sap-icon://write-new" press=".onWriteReview" />
                </HBox>

                <!-- Reviews Feed -->
                <List id="reviewsFeedList"
                      items="{path: '/Reviews', parameters: {$orderby: 'createdAt desc'}}"
                      noDataText="No reviews yet for this product.">
                    <CustomListItem>
                        <VBox class="auraCartSummaryBox sapUiSmallMarginBottom" renderType="Bare">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://customer" class="sapUiTinyMarginEnd" />
                                <Text text="{authorName}" class="auraCardBrand" />
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginTop sapUiTinyMarginBottom">
                                <RatingIndicator value="{rating}" maxValue="5" enabled="false" iconSize="0.875rem" />
                                <Text text="{headline}" class="auraActionMaintext sapUiSmallMarginBegin" />
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <ObjectStatus text="{i18n>pdpVerifiedPurchase}" state="Success" inverted="true" class="sapUiTinyMarginEnd" />
                                <Text text="Reviewed on {path: 'createdAt', formatter: '.formatter.formatDate'}" class="auraMutedText" />
                            </HBox>
                            <Text text="{comment}" class="sapUiSmallMarginBottom" />
                            <HBox alignItems="Center">
                                <Button text="{i18n>pdpWasThisHelpful} ({helpfulVotes})" type="Transparent" icon="sap-icon://thumb-up" press=".onHelpfulVote" />
                            </HBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>

            <!-- Footer -->
            <core:Fragment fragmentName="marketplace.shop.view.fragments.Footer" type="XML" />
        </content>
    </Page>
</mvc:View>
