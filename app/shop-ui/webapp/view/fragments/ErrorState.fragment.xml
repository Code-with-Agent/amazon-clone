<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <VBox class="auraErrorStateBox sapUiLargeMargin" alignItems="Center" justifyContent="Center">
        <core:Icon src="sap-icon://alert" size="3.5rem" color="#ea580c" class="sapUiMediumMarginBottom" />
        <Title text="{i18n>searchNoResultsTitle}" level="H3" class="sapUiTinyMarginBottom" />
        <Text text="{i18n>searchNoResultsText}" class="auraMutedText sapUiMediumMarginBottom" />
        <Button text="Retry Operation" type="Emphasized" icon="sap-icon://refresh" press=".onRetryOperation" />
    </VBox>
</core:FragmentDefinition>
