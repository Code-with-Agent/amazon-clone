<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <VBox class="auraPaymentMethodBlock" renderType="Bare">
        <!-- 6 Payment Methods Selection -->
        <RadioButtonGroup id="checkoutPaymentMethodGroup"
                          select=".onPaymentMethodChange"
                          columns="{= ${device>/system/phone} ? 1 : 3 }"
                          class="sapUiSmallMarginBottom">
            <RadioButton text="Credit Card" selected="true" key="CREDIT_CARD" />
            <RadioButton text="Debit Card" key="DEBIT_CARD" />
            <RadioButton text="UPI / Instant Pay" key="UPI" />
            <RadioButton text="Net Banking" key="NET_BANKING" />
            <RadioButton text="Digital Wallet" key="WALLET" />
            <RadioButton text="Cash on Delivery (COD)" key="CASH_ON_DELIVERY" />
        </RadioButtonGroup>

        <!-- Form 1: Credit Card Details -->
        <VBox id="creditCardFormContainer" class="auraCardFormBox sapUiSmallMarginTop sapUiSmallMarginBottom" renderType="Bare" visible="true">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://credit-card" class="sapUiSmallMarginEnd auraCardFormIcon" />
                <Title text="Enter Credit Card Information" level="H5" />
            </HBox>
            <VBox class="sapUiTinyMarginBottom" renderType="Bare">
                <Label text="Name on Card" required="true" />
                <Input id="ccHolderInput" placeholder="Alice Smith" width="100%" />
            </VBox>
            <VBox class="sapUiTinyMarginBottom" renderType="Bare">
                <Label text="{i18n>checkoutCardNumber}" required="true" />
                <Input id="checkoutCardNumberInput" placeholder="4532 •••• •••• 8890" maxLength="19" width="100%" />
            </VBox>
            <HBox class="sapUiTinyMarginBottom">
                <VBox class="sapUiSmallMarginEnd" width="50%" renderType="Bare">
                    <Label text="{i18n>checkoutExpiry}" required="true" />
                    <Input id="checkoutCardExpiryInput" placeholder="12/28" maxLength="5" width="100%" />
                </VBox>
                <VBox width="50%" renderType="Bare">
                    <Label text="{i18n>checkoutCVV}" required="true" />
                    <Input id="checkoutCardCvvInput" placeholder="•••" maxLength="4" width="100%" type="Password" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Form 2: Debit Card Details -->
        <VBox id="debitCardFormContainer" class="auraCardFormBox sapUiSmallMarginTop sapUiSmallMarginBottom" renderType="Bare" visible="false">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://credit-card" class="sapUiSmallMarginEnd auraCardFormIcon" />
                <Title text="Enter Debit Card Details" level="H5" />
            </HBox>
            <VBox class="sapUiTinyMarginBottom" renderType="Bare">
                <Label text="Debit Card Number" required="true" />
                <Input id="dcNumberInput" placeholder="6071 •••• •••• 4421" maxLength="19" width="100%" />
            </VBox>
            <HBox class="sapUiTinyMarginBottom">
                <VBox class="sapUiSmallMarginEnd" width="50%" renderType="Bare">
                    <Label text="Valid Thru (MM/YY)" required="true" />
                    <Input id="dcExpiryInput" placeholder="09/27" maxLength="5" width="100%" />
                </VBox>
                <VBox width="50%" renderType="Bare">
                    <Label text="CVV / PIN" required="true" />
                    <Input id="dcCvvInput" placeholder="•••" maxLength="4" width="100%" type="Password" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Form 3: UPI Payment -->
        <VBox id="upiFormContainer" class="auraCardFormBox sapUiSmallMarginTop sapUiSmallMarginBottom" renderType="Bare" visible="false">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://iphone" class="sapUiSmallMarginEnd auraCardFormIcon" />
                <Title text="Pay via UPI Virtual Private Address (VPA)" level="H5" />
            </HBox>
            <Label text="Enter UPI ID / VPA" required="true" />
            <HBox alignItems="Center" class="sapUiTinyMarginTop">
                <Input id="upiIdInput" placeholder="alice@okhdfcbank" width="280px" class="sapUiSmallMarginEnd" />
                <Button text="Verify VPA" type="Ghost" press=".onVerifyUPI" />
            </HBox>
            <Text text="A payment request will be sent to your UPI app (Google Pay, PhonePe, Paytm, BHIM)." class="auraMutedText sapUiSmallMarginTop" />
        </VBox>

        <!-- Form 4: Net Banking -->
        <VBox id="netBankingFormContainer" class="auraCardFormBox sapUiSmallMarginTop sapUiSmallMarginBottom" renderType="Bare" visible="false">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://official-service" class="sapUiSmallMarginEnd auraCardFormIcon" />
                <Title text="Select Your Bank" level="H5" />
            </HBox>
            <Label text="Choose from Popular Banks" required="true" />
            <Select id="netBankingSelect" width="100%">
                <core:Item key="HDFC" text="HDFC Bank" />
                <core:Item key="ICICI" text="ICICI Bank" />
                <core:Item key="SBI" text="State Bank of India (SBI)" />
                <core:Item key="AXIS" text="Axis Bank" />
                <core:Item key="CHASE" text="JPMorgan Chase &amp; Co." />
                <core:Item key="CITI" text="Citibank International" />
            </Select>
            <Text text="You will be redirected to your bank's secure portal to authorize this transaction." class="auraMutedText sapUiSmallMarginTop" />
        </VBox>

        <!-- Form 5: Digital Wallet -->
        <VBox id="walletFormContainer" class="auraCardFormBox sapUiSmallMarginTop sapUiSmallMarginBottom" renderType="Bare" visible="false">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://money-bills" class="sapUiSmallMarginEnd auraCardFormIcon" />
                <Title text="Select Digital Wallet" level="H5" />
            </HBox>
            <Select id="walletSelect" width="100%">
                <core:Item key="AURA_WALLET" text="Aura Marketplace Wallet (Balance: $500.00)" />
                <core:Item key="APPLE_PAY" text="Apple Pay" />
                <core:Item key="GOOGLE_PAY" text="Google Pay" />
                <core:Item key="PAYPAL" text="PayPal Balance" />
            </Select>
        </VBox>

        <!-- Form 6: Cash on Delivery -->
        <VBox id="codFormContainer" class="auraCardFormBox sapUiSmallMarginTop sapUiSmallMarginBottom" renderType="Bare" visible="false">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://shipping-status" color="#059669" size="1.5rem" class="sapUiSmallMarginEnd" />
                <Title text="Cash on Delivery (COD)" level="H5" />
            </HBox>
            <Text text="Pay in cash or through UPI QR code at your doorstep upon package arrival. Zero extra convenience fee applies." class="auraActionMaintext" />
        </VBox>

        <!-- Security Note & Billing Checkbox -->
        <CheckBox id="checkoutSameAddressCheck" text="{i18n>checkoutBillingSameAsShipping}" selected="true" class="sapUiSmallMarginTop" />
        <HBox alignItems="Center" class="sapUiTinyMarginTop">
            <core:Icon src="sap-icon://shield" class="sapUiTinyMarginEnd" />
            <Text text="Mock payment gateway enabled for local development. Real credentials are never stored." class="auraSecurityNote" />
        </HBox>
    </VBox>
</core:FragmentDefinition>
